{
	"name": "somehow-digital/imgproxy",
	"description": "imgproxy URL builder for PHP.",
	"license": "MIT",
	"type": "library",
	"keywords": [
		"imgproxy",
		"images",
		"url",
		"builder"
	],
	"authors": [
		{
			"name": "Thomas Deinhamer",
			"email": "code@thasmo.dev",
			"homepage": "https://thasmo.com/"
		}
	],
	"homepage": "https://somehow.digital/",
	"support": {
		"email": "support@somehow.digital",
		"issues": "https://github.com/somehow-digital/php-imgproxy/issues",
		"source": "https://github.com/somehow-digital/php-imgproxy",
		"docs": "https://github.com/somehow-digital/php-imgproxy"
	},
	"require": {
		"php": "^8.2",
		"ext-openssl": "*"
	},
	"require-dev": {
		"deptrac/deptrac": "^4.7",
		"ergebnis/composer-normalize": "^2.56",
		"mockery/mockery": "^1.6",
		"pestphp/pest": "^3.0 || ^4.0 || ^5.0",
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-deprecation-rules": "^2.0",
		"phpstan/phpstan-strict-rules": "^2.0",
		"rector/rector": "^2.0",
		"roave/security-advisories": "dev-latest",
		"shipmonk/composer-dependency-analyser": "^1.8",
		"shipmonk/phpstan-rules": "^4.0",
		"symplify/easy-coding-standard": "^13.0",
		"tomasvotruba/cognitive-complexity": "^1.3"
	},
	"autoload": {
		"psr-4": {
			"SomehowDigital\\ImgProxy\\": "src/"
		}
	},
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true,
			"pestphp/pest-plugin": true
		},
		"optimize-autoloader": true,
		"platform": {
			"php": "8.2.35"
		},
		"sort-packages": true
	},
	"scripts": {
		"check": [
			"@composer-normalize",
			"@ecs",
			"@rector",
			"@phpstan",
			"@deptrac",
			"@deps",
			"@test",
			"@coverage",
			"@mutate"
		],
		"composer-normalize": "@composer normalize --dry-run --diff --no-check-lock --no-update-lock \"$(pwd)/composer.json\"",
		"composer-normalize-fix": "@composer normalize --no-check-lock --no-update-lock \"$(pwd)/composer.json\"",
		"coverage": "pest --coverage --min=100",
		"deps": "composer-dependency-analyser",
		"deptrac": [
			"deptrac analyse --no-progress",
			"deptrac debug:unassigned"
		],
		"ecs": "ecs check",
		"ecs-fix": "ecs check --fix",
		"mutate": "pest --mutate --everything --covered-only --parallel --min=100",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"rector": "rector process --dry-run",
		"rector-fix": "rector process",
		"test": "pest"
	}
}
